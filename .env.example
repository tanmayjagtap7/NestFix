# Google AI Studio key. New keys start with AQ. Older keys start with AIza.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Bright Data API key from https://brightdata.com/cp/setting/users
BRIGHT_DATA_API_KEY=

# Optional. If these zones exist on the account, Nestfix uses SERP for
# listing search and Web Unlocker for page enrichment. Leave blank to
# collect live Zillow listings and Google Maps places through the
# Bright Data Datasets API instead.
BRIGHT_DATA_SERP_ZONE=
BRIGHT_DATA_UNLOCKER_ZONE=

# Dataset ids. Defaults match Bright Data's public Zillow search and
# Google Maps scrapers. Override only if your account uses different ids.
BRIGHT_DATA_ZILLOW_SEARCH_DATASET=gd_m71oxpvxwr113ehqg
BRIGHT_DATA_ZILLOW_LISTINGS_DATASET=gd_lfqkr8wm13ixtbd8f5
BRIGHT_DATA_MAPS_DATASET=gd_m8ebnr0q2qlklc02fz

DATABASE_URL=sqlite:///./nestfix.db
